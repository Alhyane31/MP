xe9e, neurologique p\xe9riph\xe9rique; algies post zost\xe9riennes (Complications dues \xe0 l''infection chronique par le virus de la varicelle)',428,5,'\u0627\u0644\u062d\u0644\u0623 \u0627\u0644\u0646\u0637\u0627\u0642\u064a \u0648 \u0645\u0638\u0627\u0647\u0631\u0647 \u0627\u0644\u062c\u0644\u062f\u064a\u0629, \u0627\u0644\u0623\u0630\u0646\u064a\u0629 , \u0627\u0644\u0639\u064a\u0646\u064a\u0629, \u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0633\u062d\u0627\u064a\u0627, \u0648 \u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0639\u0635\u0628\u064a \u0627\u0644\u0637\u0631\u0641\u064a, \u0622\u0644\u0627\u0645 \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u062d\u0644\u0623 \u0627\u0644\u0646\u0637\u0627\u0642\u064a \u0644\u0644\u0634\u062e\u0635 \u0627\u0644\u0630\u064a \u0643\u0627\u0646 \u064a\u0639\u0627\u0646\u064a \u0633\u0627\u0628\u0642\u0627 \u0645\u0646 \u062c\u062f\u0631\u064a \u0627\u0644\u0645\u0627\u0621')\n          "))}))})),n.transaction((function(n){n.executeSql('SELECT COUNT(*) AS count FROM Agents',[],(function(n,i){console.log('DUDU'),0===i.rows.item(0).count&&n.executeSql("INSERT INTO Agents (LibelleFR,ID,NTAB,LibelleAR) VALUES\n    ('Plomb et ses compos\xe9s',1,'1.1.1','\u0627\u0644\u0631\u0635\u0627\u0635 \u0648 \u0645\u0631\u0643\u0628\u0627\u062a\u0647'),\n    ('Fluor, Acide fluorhydrique et ses sels min\xe9raux',2,'1.1.10','\u0627\u0644\u0641\u0644\u064a\u0648\u0631 \u0648 \u062d\u0645\u0636 \u0627\u0644\u0641\u0644\u064a\u0648\u0631\u064a\u062f\u0631\u064a\u0643 \u0648 \u0623\u0645\u0644\u0627\u062d\u0647 \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629'),\n    ('Ciments (Alumino-silicates de calcium)',3,'1.1.11','\u0627\u0644\u0627\u0633\u0645\u0646\u062a (\u0623\u0644\u0645\u0646\u064a\u0648-\u0633\u064a\u0644\u0633\u0643\u0627\u062a\u0627\u062a \u0627\u0644\u0643\u0644\u0633\u064a\u0648\u0645)'),\n    ('Poussi\xe8res min\xe9rales renfermant de la silice cristaline (quartz, cristobalite, tridymite), des silicates cristallins ( koalin, talc), du graphite ou de la houille',4,'1.1.12','\u0627\u0644\u063a\u0628\u0627\u0631 \u0627\u0644\u0645\u0639\u062f\u0646\u064a \u0627\u0644\u0645\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0627\u0644\u0633\u064a\u0644\u064a\u0633 \u0627\u0644\u0628\u0644\u0648\u0631\u064a (\u0643\u0648\u0627\u0631\u062a\u0632, \u0643\u0631\u064a\u0633\u062a\u0648\u0628\u0627\u0644\u064a\u062a, \u062a\u0631\u064a\u062f\u064a\u0645\u064a\u062a), \u0623\u0648 \u0627\u0644\u0633\u064a\u0644\u064a\u0643\u0627\u062a \u0627\u0644\u0628\u0644\u0648\u0631\u064a\u0629 (\u0627\u0644\u0635\u0644\u0635\u0627\u0644, \u0627\u0644\u0637\u0627\u0644\u0643) \u0623\u0648 \u0627\u0644\u063a\u0631\u0627\u0641\u064a\u062a \u0623\u0648 \u0627\u0644\u0641\u062d\u0645 \u0627\u0644\u062d\u062c\u0631\u064a'),\n    ('Poussi\xe8res d''amiante',5,'1.1.13','\u063a\u0628\u0627\u0631 \u0627\u0644\u062d\u0631\u064a\u0631 \u0627\u0644\u0635\u062e\u0631\u064a'),\n    ('Poussi\xe8res d''amiante (cancer broncho-pulmonaire)',6,'1.1.13 bis','\u063a\u0628\u0627\u0631 \u0627\u0644\u062d\u0631\u064a\u0631 \u0627\u0644\u0635\u062e\u0631\u064a (\u0627\u0644\u0633\u0631\u0637\u0627\u0646 \u0628\u0627\u0644\u0642\u0635\u0628\u0627\u062a \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629)'),\n    ('Cadmium et ses compos\xe9s',7,'1.1.14','\u0627\u0644\u0643\u0627\u062f\u0645\u064a\u0648\u0645 \u0648 \u0645\u0631\u0643\u0628\u0627\u062a\u0647'),\n    ('Poussi\xe8res ou fum\xe9es renfermant du cadmium (cancer broncho-pulmonaire)',8,'1.1.14 bis','\u063a\u0628\u0627\u0631 \u0623\u0648 \u062f\u062e\u0627\u0646 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0627\u0644\u0643\u0627\u062f\u0645\u064a\u0648\u0645 (\u0627\u0644\u0633\u0631\u0637\u0627\u0646 \u0628\u0627\u0644\u0642\u0635\u0628\u0627\u062a \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629)'),\n    ('Mines de charbon (BPCO)',9,'1.1.15','\u0645\u0646\u062c\u0645\u0648 \u0627\u0644\u0641\u062d\u0645 (\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u06