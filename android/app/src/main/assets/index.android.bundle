7\u0644\u062a\u0647\u0627\u0628 \u0633\u062d\u0627\u0626\u064a \u0644\u0645\u0641\u0627\u0648\u064a'),\n          ('M\xe9ningite purulente (pneumococcie)',238,9,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0633\u062d\u0627\u064a\u0627 \u0627\u0644\u0642\u064a\u062d\u064a'),\n          ('M\xe9ningo-Enc\xe9phalite (brucellose chronique)',239,9,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u062f\u0645\u0627\u063a \u0648 \u0627\u0644\u0633\u062d\u0627\u064a\u0627'),\n          ('M\xe9soth\xe9liome malin primitif de la pl\xe8vre, du p\xe9ritoine, du p\xe9ricarde',240,3,'\u0648\u0631\u0645 \u0627\u0644\u0645\u062a\u0648\u0633\u0637\u0629 \u0627\u0644\u062e\u0628\u064a\u062b \u0627\u0644\u0628\u062f\u0627\u0626\u064a \u0628\u0627\u0644\u062c\u0646\u0628\u0629 \u0623\u0648 \u0628\u0627\u0644\u0635\u0641\u0627\u0642 \u0623\u0648 \u0628\u0627\u0644\u062a\u0627\u0645\u0648\u0631'),\n          ('Monoarthrite aigue f\xe9brile (brucellose subaigue avec focalisation)',241,5,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0623\u062d\u0627\u062f\u064a \u0627\u0644\u0645\u0641\u0635\u0644 \u062d\u0627\u062f \u0632 \u062d\u0645\u064a'),\n          ('Mycoses de la peau glabre: L\xe9sions \xe9ryth\xe9mato- v\xe9siculeuses et squameuses circin\xe9es, appel\xe9es encore herp\xe8s circin\xe9',242,4,'\u0641\u0637\u0627\u0631\u0627\u062a \u0627\u0644\u062c\u0644\u062f \u0627\u0644\u0627\u0645\u0631\u062f: \u0625\u0635\u0627\u0628\u0627\u062a \u062d\u0645\u0627\u0645\u064a\u0629 \u062d\u0648\u064a\u0635\u0644\u064a\u0629 \u0648 \u062d\u0631\u0634\u0641\u064a\u0629 \u0645\u062a\u062d\u0644\u0642\u0629, \u062a\u0633\u0645\u0649 \u0623\u064a\u0636\u0627 \u0633\u0639\u0641\u0629 \u0645\u062a\u062d\u0644\u0642\u0629'),\n          ('Mycoses des orteils: L\xe9sions \xe9ryth\xe9mato- v\xe9siculeuses et squameuses avec fissuration des plis interdigitaux, ou aspect blanc nacr\xe9, \xe9paissi de l''\xe9piderme digital ou interdigital, accompagn\xe9 ou non de d\xe9collement, de fissures \xe9pidermiques',243,4,'\u0641\u0637\u0627\u0631\u0627\u062a \u0623\u0635\u0627\u0628\u0639 \u0627\u0644\u0642\u062f\u0645: \u0625\u0635\u0627\u0628\u0627\u062a \u062d\u0645\u0627\u0645\u064a\u0629 \u062d\u0648\u064a\u0635\u0644\u064a\u0629 \u0648 \u062d\u0631\u0634\u0641\u064a\u0629 \u0645\u0639 \u062a\u0634\u0642\u0642 \u062b\u0646\u0627\u064a\u0627 \u0645\u0627 \u0628\u064a\u0646 \u0627\u0644\u0623\u0635\u0627\u0628\u0639 \u0623\u0648 \u0635\u0628\u063a\u0629 \u0628\u064a\u0636\u0627\u0621 \u0644\u0624\u0644\u0626\u064a\u0629 \u0627\u0644\u0645\u0638\u0647\u0631 \u063a\u0644\u064a\u0638\u0629 \u0628\u062c\u0644\u062f \u0627\u0644\u0623\u0635\u0627\u0628\u0639 \u0623\u0648 \u0645\u0627 \u0628\u064a\u0646\u0647\u0627 \u0645\u0635\u062d\u0648\u0628\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0645\u0635\u062d\u0648\u0628\u0629 \u0628\u0627\u0646\u0641\u0643\u0627\u0643 \u0648 \u0634\u0642\u0648\u0642 \u062c\u0644\u062f\u064a\u0629'),\n          ('Mycoses du cuir chevelu: Plaques squameuses du cuir chevelu supportant un m\xe9lange de cheveux sains et de cheveux cass\xe9s courts, accompagn\xe9s quelquefois d''une folliculite suppur\xe9e (k\xe9rion)',244,4,'\u0641\u0637\u0627\u0631\u0627\u062a \u0641\u0631\u0629 \u0627\u0644\u0631\u0623\u0633: \u0644\u0648\u062d\u0627\u062a \u062d\u0631\u0634\u0641\u064a\u0629 \u0628\u0641\u0631\u0648\u0629 \u0627\u0644\u0631\u0623\u0633 \u062a\u062d\u062a\u0648\u064a \u062e\u0644\u064a\u0637\u0627 \u0645\u0646 \u0627\u0644\u0634\u0639\u0631 \u0627\u0644\u0633\u0644\u064a\u0645 \u0648 \u0627\u0644\u0634\u0639\u0631 \u0627\u0644\u0645\u0646\u0643\u0633\u0631 \u0627\u0644\u0642\u0635\u064a\u0631 \u0645\u0635\u062d\u0648\u0628\u0629 \u0623\u062d\u064a\u0627\u0646\u0627 \u0628\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u062c\u0631\u064a\u0628\u0627\u062a \u0627\u0644\u0642\u064a\u062d\u064a (\u0643\u0631\u064a\u0648\u0646)'),\n          ('My\xe9lite radiculaire (brucellose chronique)',245,9,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0639\u0635\u0628\u064