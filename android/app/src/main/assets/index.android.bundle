ante, oed\xe8me de Quincke, choc anaphylactique',332,4,'\u0637\u0641\u062d \u062c\u0644\u062f\u064a \u0636\u062e\u0645, \u0648\ufeab\u0645\u0629 \"\u0643\u064a\u0646\u0643\", \u0635\u062f\u0645\u0629 \u0627\u0644\u0639\u0648\u0627\u0631\u064a, \u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u0628\u0646 \u0627\u0644\u0646\u0628\u0627\u062a (latex)'),\n          ('Rhinite',333,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0623\u0646\u0641'),\n          ('Rhinite (effets caustiques)',334,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0623\u0646\u0641 (\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0643\u0627\u0648\u064a\u0629)'),\n          ('Rhinite r\xe9cidivant en cas de nouvelle exposition',335,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0623\u0646\u0641 \u0627\u0644\u0645\u062a\u0643\u0631\u0631 \u0641\u064a \u062d\u0627\u0644\u0629 \u062a\u0639\u0631\u0636 \u062c\u062f\u064a\u062f \u0644\u0644\u062e\u0637\u0631 \u0623\u0648 \u0627\u0644\u0645\u062b\u0628\u062a \u0628\u0627\u062e\u062a\u0628\u0627\u0631'),\n          ('Rhinite r\xe9cidivante',336,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0623\u0646\u0641 \u0627\u0644\u0645\u062a\u0643\u0631\u0631'),\n          ('Rickettsioses (manifestations cliniques aigues)',337,5,'\u062f\u0627\u0621 \u0627\u0644\u0631\u064a\u0643\u062a\u0633\u064a\u0627\u062a'),\n          ('Rupture partielle ou transfixiante de la coiffe des rotateurs ',338,2,'\u062a\u0645\u0632\u0642 \u062c\u0632\u0626\u064a \u0623\u0648 \u0643\u0644\u064a \u0644\u063a\u0637\u0627\u0621 \u0627\u0644\u0639\u0636\u0644\u0627\u062a \u0627\u0644\u0645\u062f\u0648\u0631\u0629'),\n          ('Sacrocoxite (brucellose chronique)',339,5,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0623\u0642\u0631\u0627\u0635'),\n          ('Salpingite (brucellose chronique)',340,5,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0646\u0641\u064a\u0631'),\n          ('Sar