623\u0635\u0627\u0628\u0639 \u0627\u0644\u064a\u062f \u0648 \u0627\u0644\u0642\u062f\u0645'),\n          ('Troubles cardiaques aigus \xe0 type d''hyperexcitabilit\xe9 ventriculaire ou supraventriculaire et disparaissant apr\xe8s l''arr\xeat de l''exposition au produit',396,8,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0642\u0644\u0628\u064a\u0629 \u062d\u0627\u062f\u0629 \u0639\u0644\u0629 \u0634\u0643\u0644 \u0627\u0646\u0641\u0639\u0627\u0644\u0627\u062a \u0645\u0641\u0631\u0637\u0629 \u0641\u064a \u0627\u0644\u0628\u0637\u064a\u0646 \u0623\u0629 \u0641\u0648\u0642 \u0627\u0644\u0628\u0637\u064a\u0646 \u0648 \u0627\u0644\u062a\u064a \u062a\u062e\u062a\u0641\u064a \u0628\u0639\u062f \u0627\u0644\u062a\u0648\u0642\u0641 \u0639\u0646 \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u0645\u0627\u062f\u0629'),\n          ('Troubles de la conduction (borr\xe9liose de Lyme)',397,9,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u062a\u0648\u0635\u064a\u0644'),\n          ('Troubles de la sensibilit\xe9 (borr\xe9liose de Lyme)',398,9,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u062a\u062d\u0633\u0633'),\n          ('Troubles de l''h\xe9mostase (intoxication aigue)',399,10,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u062e\u0627\u0635\u064a\u0629 \u0627\u0644\u0625\u0631\u0642\u0627\u0621'),\n          ('Troubles digestifs imm\xe9diats',400,11,'\u0627\u0644\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u0647\u0636\u0645\u064a\u0629 \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629'),\n          ('Troubles du rythme',401,10,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0646\u0628\u0636 \u0627\u0644\u0642\u0644\u0628'),\n          ('Troubles gastro-intestinaux aigus avec naus\xe9es, vomissements ou diarrh\xe9es',402,11,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u062d\u0627\u062f\u0629 \u0628\u0627\u0644\u0645\u0639\u062f\u0629 \u0648 \u0627\u0644\u0623\u0645\u0639\u0627\u0621 \u0645\u0635\u062d\u0648\u0628\u0629 \u0628\u063a\u062b\u064a\u0627\u0646 \u0648 \u0642\u064a\u0626 \u0648 \u0625\u0633\u0647\u0627\u0644'),\n          ('Troubles gastro-intestinaux apyr\xe9tiques accompagn\xe9s de vomissements \xe0 r\xe9p\xe9tition',403,11,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0645\u0639\u062f\u064a\u0629 \u0645\u0639\u0648\u064a\u0629 \u063a\u064a\u0631 \u062d\u0645\u064a\u0629 \u0645\u0635\u062d\u0648\u0628\u0629 \u0628\u0641\u0642\u064a\u0626 \u0645\u062a\u0643\u0631\u0631'),\n          ('Troubles labyrinthiques',404,2,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u062a\u0627\u0647\u0629'),\n          ('Troubles psychiques aigus avec confusion mentale, d\xe9lire onirique',405,9,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0646\u0641\u0633\u064a\u0629 \u062d\u0627\u062f\u0629 \u0645\u0639 \u062e\u0644\u0637 \u0630\u0647\u0646\u064a \u0648 \u0647\u0630\u064a\u0627\u0646 \u0645\u0646\u0627\u0645\u064a'),\n          ('Troubles psychiques chroniques avec \xe9tats d\xe9pressifs et impulsions morbides',406,9,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0646\u0641\u0633\u064a\u0629 \u0645\u0632\u0645\u0646\u0629 \u0645\u0639 \u062d\u0627\u0644\u0627\u062a \u0627\u0643\u062a\u0626\u0627\u0628 \u0648 \u0627\u0646\u062f\u0641\u0627\u0639\u0627\u062a \u0645\u0631\u0636\u064a\u0629'),\n          ('Troubles transitoires de la conduction cardiaque (intoxication aigue)',407,10,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0639\u0627\u0628\u0631\u0629 \u0641\u064a \u062a\u062f\u0641\u0642 \u0627\u0644\u062f\u0645'),\n          ('Troubles transitoires de l''excitabilit\xe9 cardiaque (intoxication aigue)',408,10,'\u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0639\u0627\u0628\u0631\u0629 \u0641\u064a \u0627\u0633\u062a\u062b\u0627\u0631\u0629 \u0627\u0644\u0642\u0644\u0628'),\n          ('Tuberculose cutan\xe9e ou sous-cutan\xe9e (Mycobact\xe9rium bovis)',409,5,'\u0627\u0644\u0633\u0644 \u0627\u0644\u062c\u0644\u062f\u064a \u0623\u0648 \u062a\u062d\u062a \u0627\u0644\u062c\u0644\u062f\u064a'),\n          ('Tuberculose extra-thoracique (Mycobact\xe9rium tuberculosis, Mycobact\xe9rium bovis, Mycobact\xe9rium africanum)',410,5,'\u0627\u0644\u064a\u0644 \u062e\u0627\u0631\u062c \u0627\u0644\u0642\u0641\u0635 \u0627\u0644\u0635\u062f\u0631\u064a'),\n          ('Tuberculose ganglionnaire (Mycobact\xe9rium bovis)',411,5,'\u0627\u0644\u0633\u0644 \u0627\u0644\u0639\u0642\u062f\u064a'),\n          ('Tuberculose ou autre mycobact\xe9riose (complication)',412,1,'\u0627\u0644\u0633\u0644 \u0623\u0648 \u063a\u064a\u0631\u0647 \u0645\u0646 \u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u062a\u0641\u0637\u0631\u0627\u062a \u0627\u0644\u0645\u0646\u0636\u0627\u0641\u0629 \u0648 \u0627\u0644\u0645\u062a\u0628\u062b\u0629'),\n          ('Tuberculose pleurale (Mycobact\xe9rium tuberculosis, Mycobact\xe9rium bovis, Mycobact\xe9rium africanum)',413,5,'\u0633\u0644 \u0630\u0627\u062a \u0627\u0644\u062c\u0646\u0628'),\n          ('Tuberculose pulmonaire (Mycobact\xe9rium tuberculosis, Mycobact\xe9rium bovis, Mycobact\xe9rium africanum)',414,5,'\u0627\u0644\u0633\u0644 \u0627\u0644\u0631\u0626\u0648\u064a'),\n          ('Tumeur primitive de l''\xe9pith\xe9lium urinaire (vessie, voies excr\xe9trices sup\xe9rieures)',415,3,'\u0648\u0631\u0645 \u0628\u062f\u0627\u0626\u064a \u0628\u0627\u0644\u0638\u0647\u0627\u0631\u0629 \u0627\u0644\u0628\u0648\u0644\u064a\u0629 (\u0627\u0644\u0645\u062b\u0627\u0646\u0629 \u0648 \u0627\u0644\u0645\u0633\u0627\u0644\u0643 \u0627\u0644\u0628\u0648\u0644\u064a\u0629 \u0627\u0644\u0639\u0644\u0648\u064a\u0629)'),\n          ('Tumeurs pleurales primitives',416,3,'\u0623\u0648\u0631\u0627\u0645 \u0623\u062e\u0631\u0649 \u062c\u0646\u0648\u0628\u064a\u0629 \u0628\u062f\u0627\u0626\u064a\u0629'),\n          ('Ulc\xe9rations',417,4,'\u062a\u0642\u0631\u062d\u0627\u062a \u0627\u0644\u062c\u0644\u062f'),\n          ('Ulc\xe9rations cutan\xe9es (effets caustiques)',418,4,'\u062a\u0642\u0