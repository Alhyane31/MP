0,11,'\u0627\u0644\u0625\u0633\u0647\u0627\u0644'),\n          ('Diarrh\xe9es (intoxication aigue)',111,10,'\u0625\u0633\u0647\u0627\u0644 (\u0627\u0644\u062a\u0633\u0645\u0645 \u0627\u0644\u062d\u0627\u062f)'),\n          ('Diplopie',112,2,'\u0634\u0641\u0639'),\n          ('Douleurs abdominales (intoxication aigue)',113,10,'\u0622\u0644\u0627\u0645 \u0641\u064a \u0627\u0644\u0628\u0637\u0646 (\u0627\u0644\u062a\u0633\u0645\u0645 \u0627\u0644\u062d\u0627\u062f)'),\n          ('Douleurs pr\xe9cordiales \xe0 type d''angine de poitrine',114,8,'\u0622\u0644\u0627\u0645 \u0623\u0645\u0627\u0642\u0644\u0628\u064a\u0629 \u0643\u0627\u0644\u0630\u0628\u062d\u0629 \u0627\u0644\u0635\u062f\u0631\u064a\u0629'),\n          ('Douleurs radiculaires (borr\xe9liose de Lyme)',115,9,'\u0622\u0644\u0627\u0645 \u062c\u062f\u0631\u064a\u0629'),\n          ('Dysk\xe9ratose lenticulaire en disue (maladie de Bowen)',116,4,'\u062e\u0644\u0644 \u062a\u0642\u0631\u0646 \u0628\u0627\u0644\u0628\u0634\u0631\u0629 \u0639\u062f\u0633\u064a \u0627\u0644\u0634\u0643\u0644 (\u0645\u0631\u0636 \u0628\u0648\u064a\u0646)'),\n          ('Dysk\xe9ratoses palmo-plantaires (intoxication subaigue)',117,10,'\u062e\u0644\u0644 \u062a\u0642\u0631\u0646 \u0631\u0627\u062d\u0629 \u0627\u0644\u064a\u062f \u0648 \u0628\u0627\u0637\u0646 \u0627\u0644\u0642\u062f\u0645'),\n          ('Dyspn\xe9e aigue',118,1,'\u0636\u064a\u0642 \u0627\u0644\u062a\u0646\u0641\u0633 \u0627\u0644\u062d\u0627\u062f'),\n          ('Dyspn\xe9e asthmatiforme',119,1,'\u0636\u064a\u0642 \u062a\u0646\u0641\u0633\u064a \u0631\u0628\u0648\u064a \u0627\u0644\u0634\u0643\u0644'),\n          ('Emphys\xe8me',120,1,'\u0627\u0646\u062a\u0641\u0627\u062e \u0627\u0644\u0631\u0626\u0629'),\n          ('Enc\xe9phalite (complications de la varicelle)',121,9,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u062f\u0645\u0627\u063a'),\n          ('Enc\xe9phalo-my\xe9lite progressive (borr\xe9liose de Lyme)',122,9,'\u0627\u0644\u062a\u0647\u0627\u0628 \u062f\u0645\u0627\u063a\u064a \u0646\u062e\u0627\u0639\u064a \u0645\u062a\u0635\u0627\u0639\u062f'),\n          ('Enc\xe9phalopathie aigue',123,9,'\u0627\u0639\u062a\u0644\u0627\u0644 \u062f\u0645\u0627\u063a\u064a \u062d\u0627\u062f'),\n          ('Enc\xe9phalopathie aigue associant au moins deux des signes suivants: hallucinations; d\xe9ficit moteur ou sensitif d''origine centrale; amaurose; coma; convulsions',124,9,'\u0627\u0639\u062a\u0644\u0627\u0644 \u062f\u0645\u0627\u063a\u064a \u062d\u0627\u062f \u064a\u0634\u0645\u0644 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0627\u062b\u0646\u064a\u0646 \u0645\u0646 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u0627\u0644\u064a\u0629 : \u0647\u0630\u064a\u0627\u0646, \u0639\u062c\u0632 \u062d\u0631\u0643\u064a \u0623\u0648 \u062d\u0633\u064a \u0645\u0631\u0643\u0632\u064a \u0627\u0644\u0623\u0635\u0644 , \u0643\u0645\u0646\u0629 ( \u0639\u0645\u0649 \u062c\u0632\u0626\u064a \u0623\u0648 \u0643\u0644\u064a), \u063a\u064a\u0628\u0648\u0628\u0629, \u0627\u062e\u062a\u0644\u0627\u062c\u0627\u062a'),\n          ('Enc\xe9phalopathie chronique (trois des cinq anomalies suivantes): ralentissement psychomoteur; alt\xe9ration de la dext\xe9rit\xe9; d\xe9ficit de la m\xe9moire \xe9pisodique; troubles des fonctions ex\xe9cutives; diminution de l''attention  et ne s''aggravant pas apr\xe8s cessation de l''exposition au risque',125,9,'\u0627\u0639\u062a\u0644\u0627\u0644 \u062f\u0645\u0627\u063a\u064a \u0645\u0632\u0645\u0646 (\u062b\u0644\u0627\u062a\u0629 \u0645\u0646 \u0627\u0644\u062a\u0634\u0648\u0647\u0627\u062a \u0627\u0644\u062e\u0645\u0633 \u0627\u0644\u062a\u0627\u0644\u064a\u0629): \u062a\u062e\u0644\u0641 \u0646\u0641\u0633\u064a \u062d\u0631\u0643\u064a, \u0636\u0639\u0641 \u0627\u0644\u0645\u0647\u0627\u0631\u0629, \u0639\u062c\u0632 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0639\u0631\u0636\u064a\u0629, \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u0629, \u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u064a\u0642\u0638\u0629, \u0648 \u0644\u0627\u064a\u062a\u0641\u0627\u0642\u0645 \u0628\u0639\u062f \u0627\u0644\u062a\u0648\u0642\u0641 \u0639\u0646 \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u062e\u0637\u0631'),\n          ('Enc\xe9phalopathies caract\xe9ris\xe9es par des alt\xe9rations des fonctions cognitives, constitu\xe9es par au moins trois des six anomalies suivantes: ralentissement psychomoteur ; troubles de la dext\xe9rit\xe9, de la m\xe9moire, de l''organisation visuospatiale,des fonctions ex\xe9cutives, de l''attention, et ne s''aggravant pas apr\xe8s cessation de l''exposition au risque',126,9,'\u0627\u0639\u062a\u0644\u0627\u0644\u0627\u062a \u062f\u0645\u0627\u063a\u064a\u0629 \u062a\u062a\u0645\u064a\u0632 \u0628\u0627\u062e\u062a\u0644\u0627\u0644\u0627\u062a \u0641\u064a \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u0645\u0639\u0631\u0641\u064a\u0629, \u0648 \u062a\u062a\u0623\u0644\u0641 \u0645\u0646 \u062b\u0644\u0627\u062b\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0645\u0646 \u0627\u0644\u062a\u0634\u0648\u0647\u0627\u062a \u0627\u0644\u0633\u062a\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629: \u062a\u062e\u0644\u0641 \u0646\u0641\u0633\u064a \u062d\u0631\u0643\u064a, \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0641\u064a \u0627\u0644\u0645\u0647\u0627\u0631\u0629 \u0648 \u0641\u064a \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0648 \u0641\u064a \u0627\u0644\u062a\u0646\u0638\u064a\u0645 \u0627\u0644\u0628\u0635\u0631\u064a \u0627\u0644\u0645\u0643\u0627\u0646\u064a \u0648 \u0641\u064a \u0627\u0644\u0648\u0638\u0627\u0626\u0641 \u0627\u0644\u062a\u0646\u0641\u064a\u0630\u064a\u0629 \u0648 \u0641\u064a \u0627\u0644\u064a\u0642\u0638\u0629 \u0648 \u0627\u0644\u062a\u064a \u0644\u0627 \u062a\u062a\u0641\u0627\u0642\u0645 \u0628\u0639\u062f \u0627\u0644\u062a\u0648\u0642\u0641 \u0639\u0646 \u0627\u0644\u062a\u0639\u0631\u0636 \u0644\u0644\u062e\u0637\u0631'),\n          ('Endocardite',127,5,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0634\u063a\u0627\u0641'),\n          ('Epaississement de la pl\xe8vre visc\xe9rale, soit diffus soit localis\xe9',128,1,'\u062a\u062a\u062e\u0646 \u063a\u0634\u0627\u0621 \u0627\u0644\u062c\u0646\u0628 \u0627\u0644\u062d\u0634\u0648\u064a \u0633\u0648\u0627\u0621 \u0643\u0627\u0646 \u0645\u0648\u0636\u0639\u064a\u0627 \u0623\u0648 \u0645\u0646\u062a\u0634\u0631\u0627'),\n          ('Epicondylite du coude',129,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0644\u0642\u064a\u0645\u0629'),\n          ('Epididymite (brucellose chronique)',130,5,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0628\u0631\u0628\u062e'),\n          ('Epith\xe9lioma cutan\xe9 primitif',131,3,'\u0627\u0644\u0648\u0631\u0645 \u0627\u0644\u0638\u0647\u0627\u0631\u064a \u0627\u0644\u062c\u0644\u062f\u064a \u0627\u0644\u0628\u062f\u0627\u0626\u064a'),\n          ('\xc9pitrochl\xe9ite du coude',132,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0628\u0643\u064a\u0631\u0629'),\n          ('Erysip\xe8le (streptococcie)',133,5,'\u062d\u0645\u064a\u0631\u0629'),\n          ('Eryth\xe8me migrant de Lipschutz (borr\xe9liose de Lyme)',134,4,'\u062d\u0645\u0627\u0645\u064a \u0644\u0628\u0634\u0648\u062a\u0633'),\n          ('Eryth\xe8me noueux (h\xe9patite \xe0 virus B)',135,4,'\u062d\u0645\u0627\u0645\u064a \u0639\u0642\u062f\u064a\u0629  (\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0628\u0641\u064a\u0631\u0648\u0633 B)'),\n          ('Eryth\xe8me noueux (h\xe9patite \xe0 virus C)',136,4,'\u062d\u0645\u0627\u0645\u064a \u0639\u0642\u062f\u064a\u0629 (\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0628\u0641\u064a\u0631\u0648\u0633 C)'),\n          ('Fibrose pulmonaire',137,1,'\u062a\u0644\u064a\u0641 \u0631\u0626\u0648\u064a'),\n          ('Fibrose pulmonaire diffuse avec troubles fonctionnels et signes g\xe9n\xe9raux ( amaigrissement, fatigue), les complications cardiaques ( insuffisance ventriculaire droite) et les complications pleuropulmonaires secondaires (pneumothorax spontan\xe9)',138,1,'\u062a\u0644\u064a\u0641 \u0631\u0626\u0648\u064a \u0645\u0646\u062a\u0634\u0631 \u0645\u0639 \u0648\u062c\u0648\u062f \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0648\u0638\u064a\u0641\u064a\u0629 \u0648 \u0639\u0644\u0627\u0645\u0627\u062a \u0639\u0627\u0645\u0629 ( \u0646\u062d\u0648\u0644 \u0648 \u0648\u0647\u0646) \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0645\u0636\u0627\u0639\u0641\u0627\u062a \u0627\u0644\u0642\u0644\u0628\u064a\u0629 (\u0639\u062c\u0632 \u0627\u0644\u0628\u0637\u064a\u0646 \u0627\u0644\u0623\u064a\u0645\u0646) \u0648 \u0627\u0644\u0645\u0636\u0627\u0639\u0641\u0627\u062a \u0627\u0644\u062c\u0646\u0648\u0628\u064a\u0629 \u0627\u0644\u0631\u0626\u0648\u064a\u0629 \u0627\u0644\u062b\u0627\u0646\u0648\u064a\u0629 (\u0627\u0633\u062a\u0631\u0648\u0627\u062d \u0627\u0644\u0635\u062f\u0631 \u0627\u0644\u0639\u0641\u0648\u064a)'),\n          ('Fibrose pulmonaire diffuse et ses complications: infection pulmonaire, insuffisance ventriculaire droite',139,1,'\u062a\u0644\u064a\u0641 \u0631\u0626\u0648\u064a \u0645\u0646\u062a\u0634\u0631 \u0648 \u0645\u0636\u0627\u0639\u0627\u0641\u0627\u062a\u0647: \u062a\u0639\u0641\u0646 \u0631\u0626\u0648\u064a, \u0639\u062c\u0632 \u0627\u0644\u0628\u0637\u064a\u0646 \u0627\u0644\u0623\u064a\u0645\u0646'),\n          ('Fi\xe8vre ondulante sudoro-algique (brucellose aigue avec septic\xe9mie)',140,5,'\u062d\u0645\u0649 \u0645\u062a\u0645\u0648\u062c\u0629 \u062a\u0639\u0631\u0642\u064a\u0629 \u0645\u0624\u0644\u0645\u0629'),\n          ('Fissuration ou rupture du m\xe9nisuqe (complications)',141,2,'\u062a\u0634\u0642\u0642 \u0623\u0648 \u062a\u0645\u0632\u0642 \u0627\u0644\u063a\u0636\u0631\u0648\u0641 \u0627\u0644\u0645\u0641\u0635\u0644\u064a (\u0645\u0636\u0627\u0639\u0641\u0627\u062a)'),\n          ('Formes \xe0 rechute (h\xe9patite \xe0 virus A)',142,11,'\u0627\u0644\u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u0627\u0646\u062a\u0643\u0627\u0633\u064a\u0629'),\n          ('Formes g\xe9nitales subaigu\xebs (brucellose subaigue avec focalisation)',143,5,'\u0625\u0635\u0627\u0628\u0627\u062a \u062a\u0646\u0627\u0633\u0644\u064a\u0629 \u0634\u0628\u0647 \u062d\u0627\u062f\u0629'),\n          ('Formes h\xe9pato-spl\xe9niques subaigues (brucellose subaigue avec focalisation)',144,5,'\u0625\u0635\u0627\u0628\u0627\u062a \u0634\u0628\u0647 \u062d\u0627\u062f\u0629 \u0628\u0627\u0644\u0643\u0628\u062f \u0648 \u0627\u0644\u0637\u062d\u0627\u0644'),\n          ('Formes neurom\xe9ning\xe9es',145,9,'\u0623\u0634\u0643\u0627\u0644 \u0639\u0635\u0628\u064a\u0629 \u0633\u062d\u0627\u0626\u064a\u0629'),\n          ('Formes typho\xefdes avec troubles digestifs et \xe9tats stuporeux',146,5,'\u0623\u0634\u0643\u0627\u0644 \u0645\u0646 \u062d\u0645\u0649 \u062a\u064a\u0641\u064a\u0629 \u0645\u0639 \u0627\u0636\u0637\u0631\u0627\u0628\u0627\u062a \u0647\u0636\u0645\u064a\u0629 \u0648 \u062d\u0627\u0644\u0627\u062a \u0630\u0647\u0648\u0644'),\n          ('Gale avec prurit et surinfections des atteintes cutan\xe9es',147,5,'\u062c\u0631\u0628 \u0645\u0635\u062d\u0648\u0628 \u0628\u062d\u0643\u0629 \u0634\u062f\u064a\u062f\u0629 \u0648 \u0623\u062d\u064a\u0627\u0646\u0627 \u064a\u062a\u0636\u0627\u0639\u0641 \u0627\u0644\u062a\u0639\u0641\u0646 \u0641\u064a \u0627\u0644\u0623\u0645\u0627\u0643\u0646 \u0627\u0644\u062c\u0644\u062f\u064a\u0629 \u0627\u0644\u0645\u0635\u0627\u0628\u0629 \u0628\u0627\u0644\u0637\u0641\u064a\u0644\u064a'),\n          ('Glom\xe9rulon\xe9phrite aigue (streptococcie)',148,6,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0643\u0628\u064a\u0628\u0627\u062a \u0627\u0644\u0643\u0644\u064a \u0627\u0644\u062d\u0627\u062f'),\n          ('Gonococcie cutan\xe9e',149,5,'\u062f\u0627\u0621 \u0627\u0644\u0645\u0643\u0648\u0631\u0627\u062a \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062c\u0644\u062f\u064a\u0629'),\n          ('Granulome cutan\xe9 avec r\xe9action gigantofolliculaire',150,4,'\u0648\u0631\u0645 \u062d\u0628\u064a\u0628\u064a \u062c\u0644\u062f\u064a \u0643\u0639 \u062a\u0641\u0627\u0639\u0644 \u062c\u0631\u064a\u0628\u064a \u0645\u062a\u0639\u0645\u0644\u0642'),\n          ('Graphitose',151,1,'\u0633\u062d\u0627\u0631 \u063a\u0631\u0627\u0641\u064a\u062a\u064a'),\n          ('H\xe9moglobinurie',152,7,'\u062a\u0648\u0627\u062c\u062f \u0627\u0644\u062e\u0636\u0627\u0628 \u0627\u0644\u062f\u0645\u0648\u064a \u0641\u064a \u0627\u0644\u0628\u0648\u0644 - \u0628\u064a\u0644\u0629 \u0647\u064a\u0645\u0648\u063a\u0644\u0648\u0628\u064a\u0646\u064a\u0629'),\n          ('H\xe9morragie (brucellose chronique)',153,7,'\u0646\u0632\u064a\u0641'),\n          ('H\xe9patite',154,5,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0643\u0628\u062f\u064a'),\n          ('H\xe9patite (brucellose chronique)',155,11,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f'),\n          ('H\xe9patite aigue (Co-infection d''une h\xe9patite B par le virus D)',156,11,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0627\u0644\u062d\u0627\u062f \u0645\u0639 \u0623\u0648 \u0628\u062f\u0648\u0646 \u0645\u0638\u0627\u0647\u0631 \u064a\u0631\u0642\u0627\u0646\u064a\u0629 (\u0627\u0644\u0639\u062f\u0648\u0649 \u0627\u0644\u0645\u0634\u062a\u0631\u0643\u0629 \u0628\u0641\u064a\u0631\u0648\u0633 \u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f B \u0645\u0639 \u0641\u064a\u0631\u0648\u0633 D)'),\n          ('H\xe9patite aigue (H\xe9patite \xe0 virus C)',157,11,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0627\u0644\u062d\u0627\u062f (\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0628\u0641\u064a\u0631\u0648\u0633 C)'),\n          ('H\xe9patite aigu\xeb avec ou sans manifestations ict\xe9riques (h\xe9patite \xe0 virus B)',158,11,'\u