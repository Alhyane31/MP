0627 \u0623\u0648 \u063a\u064a\u0631 \u064a\u0631\u0642\u0627\u0646\u064a'),\n          ('Hygroma aigu des bourses s\xe9reuses du coude',171,2,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0627\u0644\u062d\u0627\u062f\u0629 \u0628\u0627\u0644\u0623\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0635\u0644\u064a\u0629'),\n          ('Hygroma aigu des bourses s\xe9reuses du genou',172,2,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0627\u0644\u062d\u0627\u062f\u0629 \u0628\u0627\u0644\u0623\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0635\u0644\u064a\u0629 \u0628\u0627\u0644\u0631\u0643\u0628\u0629'),\n          ('Hygroma chronique des bourses s\xe9reuses du coude',173,2,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u0632\u0645\u0646\u0629 \u0628\u0627\u0644\u0623\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0635\u0644\u064a\u0629'),\n          ('Hygroma chronique des bourses s\xe9reuses du genou',174,2,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u0632\u0645\u0646\u0629 \u0628\u0627\u0644\u0623\u062c\u0631\u0628\u0629 \u0627\u0644\u0645\u0635\u0644\u064a\u0629 \u0628\u0627\u0644\u0631\u0643\u0628\u0629'),\n          ('Hyperacousie',175,2,'\u0641\u0631\u0637 \u0627\u0644\u0633\u0645\u0639'),\n          ('Hypersalivation',176,11,'\u0633\u064a\u0644\u0627\u0646 \u0627\u0644\u0644\u0639\u0627\u0628 \u0627\u0644\u0645\u0641\u0631\u0637'),\n          ('Hypertension art\xe9rielle (intoxications chroniques)',177,10,'\u0627\u0631\u062a\u0641\u0627\u0639 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u062f\u0645\u0648\u064a'),\n          ('Hypoacousie de perception par l\xe9sion cochl\xe9aire irr\xe9versible',178,2,'\u0646\u0642\u0635 \u0627\u0644\u0633\u0645\u0639 \u0627\u0644\u0625\u062f\u0631\u0627\u0643\u064a'),\n          ('Hypoacousie par l\xe9sion cochl\xe9aire irr\xe9versible',179,2,'\u0636\u0639\u0641 \u0627\u0644\u0633\u0645\u0639 \u0645\u0639 \u0625\u0635\u0627\u0628\u0629 \u0642\u0648\u0642\u0639\u064a\u0629 \u063a\u064a\u0631 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0639\u0644\u0627\u062c'),\n          ('Hypoplasies et aplasies m\xe9dullaires isol\xe9es ou associ\xe9es (an\xe9mie, leucop\xe9nie,thrombop\xe9nie) acquises primitives non r\xe9versibles',180,7,'\u0646\u0642\u0635 \u0623\u0648\u062e\u0644\u0644 \u0627\u0644\u062a\u0646\u0633\u062c \u0627\u0644\u0646\u0642\u0648\u064a \u0645\u0639\u0632\u0648\u0644\u0627 \u0623\u0648 \u0645\u0634\u062a\u0631\u0643\u0627 (\u0641\u0642\u0631 \u0627\u0644\u062f\u0645, \u0642\u0644\u0629 \u0627\u0644\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0628\u064a\u0636\u0627\u0621, \u0642\u0644\u0629 \u0627\u0644\u0635\u0641\u064a\u062d\u0627\u062a) \u0648 \u0645\u0643\u062a\u0633\u0628\u0627 \u0628\u062f\u0627\u0626\u064a\u0627 \u0648 \u063a\u064a\u0631 \u0642\u0627\u0628\u0644 \u0644\u0644\u0625\u0631\u062a\u062f\u0627\u062f'),\n          ('Hypotension',181,8,'\u0627\u0646\u062e\u0641\u0627\u0636 \u0627\u0644\u0636\u063a\u0637 \u0627\u0644\u0634\u0631\u064a\u0627\u0646\u064a'),\n          ('Ict\xe8re',182,11,'\u064a\u0631\u0642\u0627\u0646'),\n          ('Ict\xe8re avec h\xe9molyse',183,7,'\u064a\u0631\u0642\u0627\u0646 \u0648 \u062a\u0641\u062a\u062a \u0643\u0631\u064a\u0627\u062a \u0627\u0644\u062f\u0645 \u0627\u0644\u062d\u0645\u0631\u0627\u0621'),\n          ('Infarctus du myocarde',184,8,'\u0627\u062d\u062a\u0634\u0627\u0621 \u0639\u0636\u0644\u0629 \u0627\u0644\u0642\u0644\u0628'),\n          ('Infection cutan\xe9e granulomateuse ulc\xe9reuse prolong\xe9e (Mycobacterium marinum et foruitum)',185,5,'\u0627\u0644\u062a\u0639\u0641\u0646 \u0627\u0644\u062c\u0644\u062f\u064a \u0627\u0644\u062c\u0628\u064a\u0628\u0648\u0645\u064a \u0627\u0644\u062a\u0642\u0631\u062d\u064a \u0627\u0644\u0645\u062f\u064a\u062f'),\n          ('Inflammation p\xe9riungu\xe9ale, douloureuse, d''origine infectieuse, accompagn\xe9e ou non de modifications de l''ongle telles que fissurations, striations. dentelures du bord libre, coloration brun\xe2tre, onycholyse (p\xe9rionyxis et onyxis)',186,4,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0645\u0624\u0644\u0645 \u062d\u0648\u0644 \u0627\u0644\u0638\u0641\u0631 \ufeab\u0648 \u0645\u0635\u062f\u0631 \u062a\u0639\u0641\u0646\u064a \u064a\u0643\u0648\u0646 \u0645\u0635\u062d\u0648\u0628\u0627 \u0623\u0648 \u063a\u064a\u0631 \u0645\u0635\u062d\u0648\u0628 \u0628\u062a\u063a\u064a\u0631\u0627\u062a \u0641\u064a \u0627\u0644\u0638\u0641\u0631 \u0645\u062b\u0644 \u062a\u0634\u0642\u0642 \u0627\u0644\u0638\u0641\u0631 \u0648 \u062a\u062e\u0637\u0637\u0647 \u0648 \u062a\u0633\u0646\u0646\u0647 \u0648 \u0627\u0635\u0637\u0628\u0627\u063a\u0647 \u0628\u0627\u0644\u0644\u0648\u0646 \u0627\u0644\u0623\u0633\u0645\u0631 \u0648 \u062a\u0641\u0633\u062e \u0627\u0644\u0638\u0641\u0631'),\n          ('Insuffisance circulatoire (intoxication aigue)',187,10,'\u0642\u0635\u0648\u0631 \u0627\u0644\u062f\u0648\u0631\u0629 \u0627\u0644\u062f\u0645\u0648\u064a\u0629 (\u0627\u0644\u062a\u0633\u0645\u0645 \u0627\u0644\u062d\u0627\u062f)'),\n          ('Insuffisance r\xe9nale aigue (hantavirus)',188,6,'\u0641\u0634\u0644 \u0643\u0644\u0648\u064a \u062d\u0627\u062f'),\n          ('Insuffisance r\xe9nale aigue associ\xe9e ou pr\xe9c\xe9d\xe9e par un syndrome dysent\xe9rique (intoxication aigue)',189,10,'\u0641\u0634\u0644 \u0643\u0644\u0648\u064a \u062d\u0627\u062f \u0645\u0631\u062a\u0628\u0637 \u0623\u0648 \u0645\u0633\u0628\u0648\u0642 \u0628\u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u0632\u062d\u0627\u0631\u064a\u0629 (\u0627\u0644\u062a\u0633\u0645\u0645 \u0627\u0644\u062d\u0627\u062f)'),\n          ('Insuffisance respiratoire aigue',190,1,'\u0639\u062c\u0632 \u062a\u0646\u0641\u0633\u064a \u062d\u0627\u062f'),\n          ('Insuffisance respiratoire chronique caract\xe9ris\xe9e',191,1,'\u0639\u062c\u0632 \u0641\u064a \u0627\u0644\u062a\u0646\u0641\u0633 \u0645\u0632\u0645\u0646 \u0648 \u0645\u062b\u0628\u062a'),\n          ('Insuffisance respiratoire chronique obstructive secondaire \xe0 la maladie asthmatique',192,1,'\u0639\u062c\u0632 \u062a\u0646\u0641\u0633\u064a \u0645\u0632\u0645\u0646 \u0627\u0646\u0633\u062f\u0627\u062f\u064a \u062a\u0627\u0628\u0639 \u0644\u0644\u0645\u0631\u0636 \u0627\u0644\u0631\u0628\u0648\u064a'),\n          ('Insuffisance respiratoire li\xe9e \xe0 un granulome pulmonaire',193,1,'\u0639\u062c\u0632 \u062a\u0646\u0641\u0633\u064a \u0645\u0631\u062a\u0628\u0637 \u0628\u0648\u0631\u0645 \u062d\u0628\u064a\u0628\u064a \u0631\u0626\u0648\u064a'),\n          ('Insuffisance vasculaire c\xe9r\xe9brale (intoxications chroniques)',194,9,'\u0646\u0642\u0635 \u062a\u0631\u0648\u064a\u0629 \u0627\u0644\u062f\u0645\u0627\u063a'),\n          ('Insuffisance ventriculaire droite',195,8,'\u0639\u062c\u0632 \u0627\u0644\u0628\u0637\u064a\u0646 \u0627\u0644\u0623\u064a\u0645\u0646'),\n          ('Insuffisance ventriculaire droite caract\xe9ris\xe9e (complication)',196,8,'\u0639\u062c\u0632 \u0645\u062b\u0628\u062a \u0628\u0627\u0644\u0628\u0637\u064a\u0646 \u0627\u0644\u0623\u064a\u0645\u0646'),\n          ('Intoxication aigu\xeb ou subaigu\xeb avec asth\xe9nie, amaigrissement rapide, hypersudation suivie d''hyperthermie avec g\xeanerespiratoire',197,10,'\u062a\u0633\u0645\u0645 \u062d\u0627\u062f \u0623\u0648 \u0634\u0628\u0647 \u062d\u0627\u062f \u0645\u0635\u062d\u0648\u0628 \u0628\u0648\u0647\u0646 \u0648 \u0646\u062d\u0648\u0644 \u0633\u0631\u064a\u0639 \u0648 \u062a\u0639\u0631\u0642 \u0645\u0641\u0631\u0637 \u0645\u0635\u062d\u0648\u0628 \u0628\u0641\u0631\u0637 \u062d\u0631\u0627\u0631\u0629 \u0648 \u0636\u064a\u0642 \u062a\u0646\u0641\u0633'),\n          ('Intoxication suraigu\xeb avec hyperthermie, \u0153d\xe8me pulmonaire, \xe9ventuellement atteinte r\xe9nale et myocardique',198,10,'\u062a\u0633\u0645\u0645 \u062d\u0627\u062f \u062c\u062f\u0627 \u0645\u0635\u062d\u0648\u0628 \u0628\u0641\u0631\u0637 \u0627\u0644\u062d\u0631\u0627\u0631\u0629 \u0648 \u0628\u0648\u0630\u0645\u0629 \u0631\u0626\u0648\u064a\u0629 \u0648 \u0627\u062d\u062a\u0645\u0627\u0644 \u0625\u0635\u0627\u0628\u0627\u062a \u0643\u0644\u0648\u064a\u0629 \u0648 \u0639\u0636\u0644\u064a\u0629 \u0642\u0644\u0628\u064a\u0629'),\n          ('Irritation des voies a\xe9riennes sup\xe9rieures et conjonctivites',199,1,'\u062a\u0647\u064a\u064a\u062c \u0627\u0644\u0645\u062c\u0627\u0631\u064a \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629 \u0627\u0644\u0639\u0644\u064a\u0627 \u0648 \u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u0644\u062a\u062d\u0645\u0629'),\n          ('Isch\xe9mie myocardique aigue',200,8,'\u0646\u0642\u0635 \u062d\u0627\u062f \u0641\u064a \u062a\u0631\u0648\u064a\u0629 \u0639\u0636\u0644\u0629 \u0627\u0644\u0642\u0644\u0628'),\n          ('Kaolinose',201,1,'\u0633\u062d\u0627\u0631 \u0635\u0644\u0635\u0627\u0644\u064a'),\n          ('K\xe9ratite',202,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0642\u0631\u0646\u064a\u0629'),\n          ('K\xe9ratite (effets caustiques)',203,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0642\u0631\u0646\u064a\u0629 (\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0643\u0627\u0648\u064a\u0629)'),\n          ('K\xe9ratite nummulaire sous \xe9pith\xe9liale',204,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0642\u0631\u0646\u064a\u0629 \u0627\u0644\u0646\u0642\u062f\u064a\u0629 \u0627\u0644\u0634\u0643\u0644 \u062a\u062d\u062a \u0627\u0644\u0638\u0647\u0627\u0631\u064a'),\n          ('K\xe9ratite superficielle ulc\xe9reuse avec conjonctivite associ\xe9e',205,2,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0633\u0637\u062e\u064a \u0627\u0644\u0642\u0631\u062d\u064a \u0644\u0644\u0642\u0631\u0646\u064a\u0629 \u0645\u0639 \u0627\u0644\u062a\u0647\u0627\u0628 \u0645\u0634\u062a\u0631\u0643 \u0644\u0644\u0645\u0644\u062a\u062d\u0645\u0629'),\n          ('Laryngite (effets caustiques)',206,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u062d\u0646\u062c\u0631\u0629 (\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0643\u0627\u0648\u064a\u0629)'),\n          ('L\xe9sion de l''oreille interne',207,2,'\u0625\u0635\u0627\u0628\u0627\u062a \u0627\u0644\u0623\u0630\u0646 \u0627\u0644\u062f\u0627\u062e\u0644\u064a\u0629'),\n          ('L\xe9sions chroniques du m\xe9nisque \xe0 caract\xe8re d\xe9g\xe9n\xe9ratif',208,2,'\u0627\u0644\u0625\u0635\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u0632\u0645\u0646\u0629 \u0644\u0644\u063a\u0636\u0631\u0648\u0641 \u0627\u0644\u0645\u0641\u0635\u0644\u064a \u0630\u0648 \u0633\u0645\u0629 \u0627\u0646\u062d\u0644\u0627\u0644\u064a\u0629, \u0645\u062b\u0628\u062a\u0629 \u0628\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0625\u0636\u0627\u0641\u064a\u0629 \u0623\u0648 \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u062f\u062e\u0644 \u0627\u0644\u0639\u0644\u0627\u062c\u064a'),\n          ('L\xe9sions ecz\xe9matiformes',209,4,'\u0625\u0635\u0627\u0628\u0627\u062a \u0625\u0643\u0632\u064a\u0645\u064a\u0629 \u0627\u0644\u0634\u0643\u0644'),\n          ('L\xe9sions nasales: Perforations, ulc\xe9rations',210,2,'\u0625\u0635\u0627\u0628\u0627\u062a \u0627\u0644\u0623\u0646\u0641: \u062a\u0642\u0631\u062d\u0627\u062a, \u062a\u062e\u0631\u0645\u0627\u062a'),\n          ('L\xe9sions pleurales b\xe9nignes',211,1,'\u0625\u0635\u0627\u0628\u0627\u062a \u062c\u0646\u0648\u0628\u064a\u0629 \u062d\u0645\u064a\u062f\u0629'),\n          ('L\xe9sions pleuro-pneumoconiotiques \xe0 type rhumato\xefde (syndrome de Calpan-Collinet)',212,1,'\u0625\u0635\u0627\u0628\u0627\u062a \u0633\u062d\u0627\u0631\u064a\u0629 \u0628\u0630\u0627\u062a \u0627\u0644\u062c\u0646\u0628 \u0645\u0646 \u0627\u0644\u0646\u0648\u0639 \u0627\u0644\u0631\u062b\u064a\u0627\u0646\u064a ( \u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u0643\u0627\u0628\u0644\u0627\u0646 \u0643\u0648\u0644\u064a\u0646\u0627\u062a)'),\n          ('L\xe9sions primitives de l''\xe9pith\xe9lium v\xe9sical: l\xe9sions malignes, tumeurs b\xe9nignes',213,3,'\u0625\u0635\u0627\u0628\u0627\u062a \u0628\u062f\u0627\u0626\u064a\u0629 \u0628\u0638\u0647\u0627\u0631\u0629 \u0627\u0644\u0645\u062b\u0627\u0646\u0629: \u0623\u0648\u0631\u0627\u0645 \u062e\u0628\u064a\u062b\u0629, \u0623\u0648\u0631\u0627\u0645 \u062d\u0645\u064a\u062f\u0629'),\n          ('L\xe9soins ecz\xe9matiformes r\xe9cidivant en cas de nouvelle exposition au risque',214,4,'\u0625\u0635\u0627\u0628\u0627\u062a \u0625\u0643\u0632\u064a\u0645\u064a\u0629 \u0627\u0644\u0634\u0643\u0644 \u0645\u062a\u0643\u0631\u0631\u0629 \u0628\u0639\u062f \u0627\u0644\u062a\u0639\u0631\u0636 \u0645\u0646 \u062c\u062f\u064a\u062f \u0644\u0644\u062e\u0637\u0631 \u0623\u0648 \u0645\u062b\u0628\u062a\u0629 \u0628\u0627\u062e\u062a\u0628\u0627\u0631 \u062c\u0644\u062f\u064a \u0633\u0637\u062d\u064a'),\n          ('Leuc\xe9mies',215,3,'\u0627\u0628\u064a\u0636\u0627\u0636 \u0627\u0644\u062f\u0645'),\n          ('Leuc\xe9mies aigues my\xe9loblastique et lymphoblastique \xe0 l''exclusions des leuc\xe9mies aigues avec des ant\xe9c\xe9dents d''h\xe9mopathies',216,3,'\u0627\u0628\u064a\u0636\u0627\u0636 \u0627\u0644\u062f\u0645 \u0627\u0644\u062d\u0627\u062f \u0627\u0644\u0646\u0642\u0648\u064a \u0648 \u0627\u0644\u0644\u0645\u0641\u0627\u0648\u064a'),\n          ('Leucop\xe9nie',217,7,'\u0646\u0642\u0635 \u0627\u0644\u0643\u0631\u064a\u0636\u0627\u062a'),\n          ('Lichen plan (h\xe9patite \xe0 virus C)',218,4,'\u0627\u0644\u062d\u0632\u0627\u0632 \u0627\u0644\u062c\u0644\u062f\u064a'),\n          ('Localisations visc\xe9rales, cutan\xe9o-muqueuses et oculaires (Pseudomonas aeruginosa)',219,5,'\u0625\u0635\u0627\u0628\u0627\u062a \u0645\u0648\u0636\u0639\u064a\u0629 \u0641\u064a \u0627\u0644\u0623\u062d\u0634\u0627\u0621, \u0648 \u0625\u0636\u0627\u0628\u0627\u062a \u0645\u0648\u0636\u0639\u064a\u0629 \u062c\u0644\u062f\u064a\u0629 \u0645\u062e\u0627\u0637\u064a\u0629 \u0648 \u0628\u0635\u0631\u064a\u0629'),\n          ('Maladie de parkinson',220,9,'\u0645\u0631\u063