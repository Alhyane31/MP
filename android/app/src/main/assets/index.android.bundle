4\u062f\u0645\u0648\u064a\u0629'),\n('Pathologies neurologiques et psychiatriques', 9, '\u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0639\u0635\u0628\u064a\u0629 \u0648\u0627\u0644\u0646\u0641\u0633\u064a\u0629'),\n('Intoxications', 10, '\u0627\u0644\u062a\u0633\u0645\u0645\u0627\u062a'),\n('Pathologies h\xe9patho-gastro-intestinales', 11, '\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0643\u0628\u062f \u0648\u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0647\u0636\u0645\u064a'),\n('Pathologies ost\xe9oarticulaires', 12, '\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0639\u0638\u0627\u0645 \u0648\u0627\u0644\u0645\u0641\u0627\u0635\u0644'),\n('Pathologies auto-immunes', 13, '\u0627\u0644\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u0645\u0646\u0627\u0639\u064a\u0629 \u0627\u0644\u0630\u0627\u062a\u064a\u0629'),\n('Pathologies diverses', 14, '\u0623\u0645\u0631\u0627\u0636 \u0645\u062a\u0646\u0648\u0639\u0629'),\n('Pathologies endocriniennes', 15, '\u0623\u0645\u0631\u0627\u0636 \u0627\u0644\u063a\u062f\u062f \u0627\u0644\u0635\u0645\u0627\u0621');",[],(function(){console.log("Default values inserted into PathType.")}),(function(n,i){console.error("Error inserting values into PathType:",i.message)}))}),(function(n,i){console.error("Error checking PathType count:",i.message)})),console.log("Bubu7")})),n.transaction((function(n){n.executeSql('SELECT COUNT(*) AS count FROM Path',[],(function(n,i){console.log("B"),0===i.rows.item(0).count&&(console.log('DUDU1'),n.executeSql("INSERT INTO Path (LibelleFR,ID,PathTypeID,LibelleAR) VALUES\n          ('Acc\xe8s confusionnels',1,9,'\u0646\u0648\u0628\u0627\u062a \u0627\u062e\u062a\u0628\u0627\u0644'),\n          ('Accidents aigus',2,9,'\u0627\u0644\u062d\u0648\u0627\u062f\u062b \u0627\u0644\u062d\u0627\u062f\u0629'),\n          ('Accidents nerveux aigus',3,9,'\u062d\u0648\u0627\u062f\u062b \u0639\u0635\u0628\u064a\u0629 \u062d\u0627\u062f\u0629'),\n          ('Acn\xe9',4,4,'\u062d\u0628 \u0627\u0644\u0634\u0628\u0627\u0628 (\u0627\u0644\u0639\u062f)'),\n          ('Acouph\xe8nes',5,2,'\u0627\u0644\u0625\u062d\u0633\u0627\u0633 \u0627\u0644\u0633\u0645\u0639\u064a \u0627\u0644\u0645\u0631\u0636\u064a'),\n          ('Acrodermatite papuleuse (h\xe9patite \xe0 virus B)',6,4,'\u0627\u0644\u062a\u0647\u0627\u0628 \u062c\u0644\u062f \u0627\u0644\u0623\u0637\u0631\u0627\u0641 \u0627\u0644\u062d\u0637\u0627\u0637\u064a'),\n          ('Ad\xe9nocarcinome h\xe9patocellulaire',7,3,'\u0633\u0631\u0637\u0627\u0646 \u063a\u062f\u064a \u0644\u062e\u0644\u0627\u064a\u0627 \u0627\u0644\u0643\u0628\u062f'),\n          ('Ad\xe9nopathie (brucellose chronique)',8,5,'\u062a\u0636\u062e\u0645 \u0627\u0644\u063a\u062f\u062f \u0627\u0644\u0644\u0645\u0641\u064a\u0629'),\n          ('Affections des voies a\xe9riennes',9,1,'\u0627\u0644\u0627\u0639\u062a\u0644\u0627\u0644\u0627\u062a \u0628\u0627\u0644\u0645\u062c\u0627\u0631\u064a \u0627\u0644\u062a\u0646\u0641\u0633\u064a\u0629'),\n          ('Amaurose',10,2,'\u0643\u0645\u0646\u0629'),\n          ('Amblyopie',11,2,'\u063a\u0645\u0634'),\n          ('Amn\xe9sie',12,9,'\u0641\u0642\u062f\u0627\u0646 \u0627\u0644\u0630\u0627\u0643\u0631\u0629'),\n          ('An\xe9mie',13,5,'\u0641\u0642\u0631 \u0627\u0644\u062f\u0645'),\n          ('An\xe9mie de type h\xe9molytique',14,7,'\u0641\u0642\u0631 \u0627\u0644\u062f\u0645 \u0627\u0644\u0627\u0646\u062d\u0644\u0627\u0644\u064a'),\n          ('An\xe9mie h\xe9molytique (h\xe9patite \xe0 virus B)',15,7,'\u0641\u0642\u0631 \u0627\u0644\u062f\u0645 \u0627\u0644\u0627\u0646\u062d\u0644\u0627\u0644\u064a  (\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0628\u0641\u064a\u0631\u0648\u0633 B)'),\n          ('An\xe9mie, leucop\xe9nie, thrombop\xe9nie ou syndrome h\xe9morragique cons\xe9cutifs \xe0 une irradiation aigu\xeb',16,7,'\u0641\u0642\u0631 \u0627\u0644\u062f\u0645 \u0648 \u0642\u0644\u0629 \u0627\u0644\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0628\u064a\u0636\u0627\u0621 \u0648 \u0642\u0644\u0629 \u0627\u0644\u0635\u0641\u064a\u062d\u0627\u062a \u0623\u0648 \u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u0646\u0632\u0641\u064a\u0629 \u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0625\u0634\u0639\u0627\u0639\u0627\u062a \u062d\u0627\u062f\u0629'),\n          ('An\xe9mie, leucop\xe9nie, thrombop\xe9nie ou syndrome h\xe9morragique, cons\xe9cutifs \xe0 une irradiation chronique',17,7,'\u0641\u0642\u0631 \u0627\u0644\u062f\u0645 \u0648 \u0642\u0644\u0629 \u0627\u0644\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0628\u064a\u0636\u0627\u0621 \u0648 \u0642\u0644\u0629 \u0627\u0644\u0635\u0641\u064a\u062d\u0627\u062a \u0623\u0648 \u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u0646\u0632\u0641\u064a\u0629 \u0646\u0627\u062a\u062c\u0629 \u0639\u0646 \u0625\u0634\u0639\u0627\u0639\u0627\u062a \u0645\u0632\u0645\u0646\u0629'),\n          ('An\xe9mies h\xe9molytiques',18,7,'\u0641\u0642\u0631 \u0627\u0644\u062f\u0645 \u0627\u0644\u0627\u0646\u062d\u0644\u0627\u0644\u064a \u0630\u0648 \u0627\u0644\u062d\u062f\u0648\u062b \u0627\u0644\u0645\u0641\u0627\u062c\u0626'),\n          ('Angiosarcome',19,3,'\u0627\u0644\u063a\u0631\u0646 \u0627\u0644\u0648\u0639\u0627\u0626\u064a'),\n          ('Angiosarcome du foie',20,3,'\u0627\u0644\u063a\u0631\u0646 \u0627\u0644\u0648\u0639\u0627\u0626\u064a \u0627\u0644\u0643\u0628\u062f\u064a'),\n          ('Anxi\xe9t\xe9 pantophobique',21,9,'\u0642\u0644\u0642 \u0631\u0647\u0627\u0628\u064a \u0634\u0627\u0645\u0644'),\n          ('Aphasie',22,9,'\u0627\u0644\u062d\u0628\u0633\u0629'),\n          ('Aphasie et dysarthrie',23,9,'\u0627\u0644\u062d\u0628\u0633\u0629 \u0648 \u0627\u0644\u0631\u062a\u0629'),\n          ('Aplasies ou hypoplasies m\xe9dullaires entra\xeenant: an\xe9mies, leucop\xe9nies, neutrop\xe9nies',24,7,'\u0646\u0642\u0635 \u0623\u0648 \u062e\u0644\u0644 \u0627\u0644\u062a\u0646\u0633\u062c \u0627\u0644\u0646\u0642\u0648\u064a \u0627\u0644\u0630\u064a \u064a\u0624\u062f\u064a \u0625\u0644\u0649 : \u0641\u0642\u0631 \u0627\u0644\u062f\u0645, \u0646\u0642\u0635 \u0627\u0644\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0628\u064a\u0636\u0627\u0621, \u0646\u0642\u0635 \u0627\u0644\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0628\u064a\u0636\u0627\u0621 \u0630\u0627\u062a \u0627\u0644\u062d\u0628\u064a\u0628\u0627\u062a \u0627\u0644\u0646\u0627\u0635\u0644\u0629 (\u0646\u0642\u0635 \u0627\u0644\u0643\u0631\u064a\u0627\u062a \u0627\u0644\u0639\u062f\u0644\u0629)'),\n          ('Arachno\xefdite (brucellose chronique)',25,9,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0639\u0646\u0643\u0628\u0648\u062a\u064a\u0629'),\n          ('Arr\xeat circulatoire (intoxication aigue)',26,10,'\u062a\u0648\u0642\u0641 \u0627\u0644\u062f\u0648\u0631\u0629 \u0627\u0644\u062f\u0645\u0648\u064a\u0629 (\u0627\u0644\u062a\u0633\u0645\u0645 \u0627\u0644\u062c\u0627\u062f)'),\n          ('Art\xe9rite des membres inferieurs (intoxications chroniques)',27,8,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0634\u0631\u0627\u064a\u064a\u0646 \u0627\u0644\u0633\u0627\u0642\u064a\u0646'),\n          ('Arthrite chronique destructive (borr\xe9liose de Lyme)',28,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0645\u0641\u0635\u0644\u064a \u0645\u0632\u0645\u0646 \u0645\u062e\u0631\u0628'),\n          ('Arthrite s\xe9reuse ou suppur\xe9e (brucellose chronique)',29,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0645\u0641\u0635\u0644\u064a \u0645\u0635\u0644\u064a \u0623\u0648 \u0642\u064a\u062d\u064a'),\n          ('Arthrose du coude',30,2,'\u0641\u0635\u0627\u0644 \u0627\u0644\u0645\u0631\u0641\u0642'),\n          ('Asbestose',31,11,'\u0633\u062d\u0627\u0631 \u0627\u0644\u0623\u0633\u0628\u0633\u062a'),\n          ('Aspergillose intracavitaire (complication)',32,5,'\u062f\u0627\u0621 \u0627\u0644\u0631\u0634\u0627\u0634\u064a\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u0623\u062c\u0648\u0627\u0641 \u0627\u0644\u0645\u062b\u0628\u062a \u0628\u062a\u062d\u0644\u064a\u0644 \u0645\u0635\u0644\u064a'),\n          ('Asth\xe9nie',33,9,'\u0648\u0647\u0646'),\n          ('Asth\xe9nie profonde associ\xe9e ou non \xe0 un syndrome d\xe9pressif (brucellose chronique)',34,9,'\u0648\u0647\u0646 \u0639\u0645\u064a\u0642 \u0645\u0631\u062a\u0628\u0637 \u0623\u0648 \u063a\u064a\u0631 \u0645\u0631\u062a\u0628\u0637 \u0628\u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u0627\u0643\u062a\u0622\u0628\u064a\u0629'),\n          ('Asthme',35,1,'\u0631\u0628\u0648'),\n          ('Ataxie',36,9,'\u0627\u0644\u0647\u0632\u0639'),\n          ('Ataxie C\xe9r\xe9belleuse',37,9,'\u0631\u0646\u062d \u0645\u062e\u064a\u062e\u064a'),\n          ('Atteinte des nerfs p\xe9riph\xe9riques et cr\xe2niens (syndrome de Garin-Bujadoux-Bannwarth)',38,9,'\u0625\u0635\u0627\u0628\u0627\u062a \u0627\u0644\u0623\u0639\u0635\u0627\u0628 \u0627\u0644\u0637\u0631\u0641\u064a\u0629 \u0648 \u0627\u0644\u062c\u0645\u062c\u0645\u064a\u0629 (\u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u063a\u0627\u0631\u0646 \u0648 \u0628\u0648\u062c\u0627\u062f\u0648 \u0632 \u0628\u0627\u0646\u0648\u0631\u0627\u062b)'),\n          ('Atteinte inflammatoire des tissus sous-cutan\xe9s des zones d''appui du coude',39,2,'\u0625\u0635\u0627\u0628\u0629 \u0627\u0644\u062a\u0647\u0627\u0628\u064a\u0629 \u0644\u0644\u0623\u0646\u0633\u062c\u0629 \u0627\u0644\u062c\u0644\u062f\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0628\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0627\u0631\u062a\u0641\u0627\u0642'),\n          ('Atteinte inflammatoire des tissus sous-cutan\xe9s des zones d''appui du genou',40,2,'\u0625\u0635\u0627\u0628\u0627\u062a \u0627\u0644\u062a\u0647\u0627\u0628\u064a\u0629 \u0644\u0644\u0623\u0646\u0633\u062c\u0629 \u0627\u0644\u062c\u0644\u062f\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0628\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0636\u063a\u0637 \u0628\u0627\u0644\u0631\u0643\u0628\u0629'),\n          ('Atteinte vasculaire cubito-palmaire (Syndrome du marteau hypoth\xe9nar)',41,8,'\u0625\u0635\u0627\u0628\u0629 \u0639\u0631\u0642\u064a\u0629 \u0632\u0646\u062f\u064a\u0629 \u0631\u0627\u062d\u064a\u0629 \u0641\u064a \u062d\u0627\u0646\u0628 \u0648\u0627\u062d\u062f \u0639\u0627\u062f\u0629 (\u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u0645\u0637\u0631\u0642\u0629 \u0627\u0644\u0636\u0631\u0629) \u062a\u0624\u062f\u064a \u0625\u0644\u0649 \u0638\u0627\u0647\u0631\u0629 \u0631\u0627\u064a\u0646\u0648\u062f \u0623\u0648 \u0645\u0638\u0627\u0647\u0631 \u0625\u0642\u0641\u0627\u0631\u064a\u0629 \u0628\u0627\u0644\u0623\u0635\u0627\u0628\u0639'),\n          ('Atteintes visc\xe9rales (staphylococcie)',42,5,'\u0625\u0635\u0627\u0628\u0627\u062a \u0641\u064a \u0627\u0644\u0623\u062d\u0634\u0627\u0621'),\n          ('Bl\xe9pharite',43,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u062c\u0641\u0646'),\n          ('Bl\xe9pharite (effets caustiques)',44,2,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0623\u062c\u0641\u0627\u0646 (\u0627\u0644\u062a\u0623\u062b\u064a\u0631\u0627\u062a \u0627\u0644\u0643\u0627\u0648\u064a\u0629)'),\n          ('Bl\xe9pharo-conjonctivite r\xe9cidivante',45,2,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0627\u0644\u0645\u062a\u0643\u0631\u0631\u0629 \u0628\u0627\u0644\u062c\u0641\u0646 \u0648 \u0627\u0644\u0645\u0644\u062a\u062d\u0645\u0629'),\n          ('Bradycardie',46,8,'\u0628\u0637\u0621 \u0646\u0628\u0636 \u0627\u0644\u0642\u0644\u0628'),\n          ('Bronchite',47,1,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0642\u0635\u0628\u064a'),\n          ('Broncho-alv\xe9olite aigue ou subaigue avec signes g\xe9n\xe9raux',48,1,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0642\u0635\u0628\u064a \u062d\u0627\u062f \u0623\u0648 \u0634\u0628\u0647 \u062d\u0627\u062f \u0645\u0631\u0641\u0648\u0642 \u0628\u0639\u0644\u0627\u0645\u0627\u062a \u0639\u0627\u0645\u0629'),\n          ('Bronchoalv\xe9olite aigue ou subaigue avec syndrome respiratoire (dyspn\xe9e, toux, de moisissures ou \xe0 des expectoration) et/ou signes actinomyc\xe8tes contaminant les g\xe9n\xe9raux (fi\xe8vre, particules v\xe9g\xe9tales ou animales amaigrissement)',49,1,'\u0627\u0644\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0642\u0635\u0628\u064a \u0627\u0644\u0633\u0646\u062e\u064a \u0627\u0644\u062d\u0627\u062f \u0623\u0648 \u0634\u0628\u0647 \u0627\u0644\u062d\u0627\u062f \u0645\u0639 \u0645\u062a\u0644\u0627\u0632\u0645\u0629 \u062a\u0646\u0641\u0633\u064a\u0629 (\u0636\u064a\u0642 \u062a\u0646\u0641\u0641\u0633 \u0648 \u0633\u0639\u0627\u0644 \u0648 \u0646\u0641\u062b)'),\n          ('Broncho-pneumonie (pneumococcie)',50,1,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0642\u0635\u0628\u064a \u0631\u0626\u0648\u064a'),\n          ('Broncho-pneumonie (streptococcie)',51,1,'\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0642\u0635\u0628\u064a\u0629 \u0631\u0626\u0648\u064a\u0629'),\n          ('Bronchopneumopathie aigue',52,1,'\u0627\u0644\u062a\u0647\u0627\u0628 \u0642\u0635\u0628\u064a \u0631\u0626\u0648\u064a \u062d\u0627\u062f'),\n          ('Broncho-pneumopathie aigue ou subaigue diffuse',53,1,'\u0627\u0639\u062a\u0644\u0627\u0644 \u0642\u0635\u0628\u064a \u0631\u0626\u0648\u064a \u062d\u0627\u062f \u0623\u0648 \u0634\u0628\u0647 \u062d\u0627\u062f \u0645\u0646\u062a\u0634\u0631'),\n          ('Broncho-pneumopathie chronique obstructive',54,1,'\u0627\u0644\u0627\u062a\u0647\u0627\u0628 \u0627\u0644\u0642\u0635\u0628\u064a \u0627\u0644\u0631\u0626\u0648\u064a \u0627\u0644\u0645\u0632\u0645\u0646 \u0648 \u0627\u0644\u0627\u0646\u0633\u062f\u0627\u062f\u064a \u0648 \u0627\u0644\u0645\u062a\u0631\u062a\u0628 \u0639\u0646 \u0646\u0648\u0628\u0627\u062a \u062a\u0646\u0641\u0633\u064a\u0629 \u0627\u0646\u0633\u062f\u0627\u062f\u064a\u0629 \u062d\u0627\u062f\u0629'),\n          ('Broncho-pneumopathie chronique obstructive entra\xeenant un d\xe9ficit respiratoire chronique',55,1,'\u0627\u0644\u0627\u062a\u0647\u0627\u0628 \u0627\u0644\u0642\u0635\u0628\u064a \u0627\u0644\u0631\u0626\u0648\u064a \u0627\u0644\u0645\u0632\u0645\u0646 \u0627\u0644\u0627\u0646\u0633\u062f\u0627\u062f\u0633 \u0627\u0644\u0645\u0624\u062f\u064a \u0625\u0644\u0649 \u0639\u062c\u0632 \u0645\u0632\u0645\u0646 \u0641\u064a \u0627\u0644\u062a\u0646\u0641\u0633'),\n          ('Bronchopneumopathies aigues',56,1,'\u0627\u0644\u062a\u0647\u0627\u0628\u0627\u062a \u0642\u0635\u0628\u064a\u0629 \u0631\u0626\u0648\u064a\u0629 \u062d\u0627\u062f\u0629'),\n          ('Br\xfblures chimiques',57,4,'\u0627\u0644\u062d\u0631\u0648\u0642 \u0627\u0644\u0643\u064a\u0645\u0627\u0648\u064a\u0629'),\n          ('Br\xfblures et irritations cutan\xe9es',58,4,'\u0627\u0644\u062d\u0631\u0648\u0642 \u0648 \u0627\u0644\u062a\u0647\u064a\u062c\u0627\u062a \u0627\u0644\u062c\u0644\u062f\u064a\u0629'),\n          ('Br\xfblures oculaires et conjonctivite',59,2,'\u0627\u0644\u062d\u0631\u0648\u0642 \u0627\u0644\u0628\u0635\u0631\u064a\u0629 \u0648 \u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0645\u0644\u062a\u062d\u0645\u0629'),\n          ('Cancer bronchique primitif',60,1,'\u0633\u0631\u0637\u0627\u0646 \u0628\u062f\u0627\u0626\u064a \u0628\u0627\u0644\u0642\u0635\u0628\u0627\u062a \u0627\u0644\u0647\u0648\u0627\u0626\u064a\u0629'),\n          ('Cancer broncho-pulmonaire primitif',61,1,'\u0633\u0631\u0637\u0627\u0646 \u0642\u0635\u0628\u064a \u0631\u0626\u0648\u064a \u0628\u062f\u0627\u0626\u064a'),\n          ('Cancer des cavit\xe9s nasales',62,2,'\u0633\u0631\u0637\u0627\u0646 \u0627\u0644\u062a\u062c\u0627\u0648\u064a\u0641 \u0627\u0644\u0623\u0646\u0641\u064a\u0629'),\n          ('Cancer des voies urinaires',63,3,'\u0633\u0631\u0637\u0627\u0646 \u0627\u0644\u0645\u0633\u0627\u0644\u0643 \u0627\u0644\u0628\u0648\u0644\u064a\u0629'),\n          ('Cancer primitif de l''ethmo\xefde et des sinus de la face',64,3,'\u0633\u0631\u0637\u0627\u0646 \u0628\u062f\u0627\u0626\u064a \u0628\u0627\u0644\u0639\u0638\u0645 \u0627\u0644\u0645\u0635\u0641\u0648\u064a \u0648 \u062c\u064a\u0648\u0628 \u0627\u0644\u0648\u062c\u0647'),\n          ('Cancer primitif: carcinome des fosses nasales, de l''ethmoide et des autres sinus de la face',65,3,'\u0633\u0631\u0637\u0627\u0646 \u0628\u062f\u0627\u0626\u064a : \u0633\u0631\u0637\u0627\u0646 \u063a\u062f\u064a \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u062e\u0631 \u0648 \u0641\u064a \u0627\u0644\u0639\u0638\u0645 \u0627\u0644\u063a\u0631\u0628\u0627\u0644\u064a \u0648 \u0628\u062c\u064a\u0648\u0628 \u0627\u0644\u0648\u062c\u0647'),\n          ('Carcinome du nasopharynx',66,3,'\u0633\u0631\u0637\u0627\u0646 \u0627\u0644\u0628\u0644\u0639\u0648\u0645 \u0627\u0644\u0623\u0646\u0641\u064a'),\n          ('Carcinome h\xe9pato-cellulaire (h\xe9patite \xe0 virus B)',67,3,'\u0633\u0631\u0637\u0627\u0646 \u063a\u062f\u064a \u0643\u0628\u062f\u064a \u062e\u0644\u0648\u064a (\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0628\u0641\u064a\u0631\u0648\u0633 B)'),\n          ('Carcinome h\xe9pato-cellulaire (h\xe9patite \xe0 virus C)',68,3,'\u0633\u0631\u0637\u0627\u0646 \u063a\u062f\u064a \u0643\u0628\u062f\u064a \u062e\u0644\u0648\u064a (\u0627\u0644\u062a\u0647\u0627\u0628 \u0627\u0644\u0643\u0628\u062f \u0628\u0641\u064a\u0631\u0648\u0633 C)'),\n          ('Carcinomes cutan\xe9s baso-cellulaires ou spino-cellulaires',69,3,'\u0633\u0631\u0637\u0627\u0646 \u063a\u062f\u064a \u062c\u0644\u062f\u064a \u0630\u0648 \u062e\u0644\u0627\u064a\u0627 \u0642\u0627\u0639\u062f\u064a\u0629 \u0623\u0648 \u062d\u0631\u0634\u0641\u064a\u0629'),\n          ('Cardiopathie isch\xe9mique (intoxications chroniques)',70,8,'\u0645\u0631\u0636 \u0627\u0644\u0642\u0644\u0628 \u0627\u0644\u0625\u0642\u0641\u0627\u0631\u064a'),\n          ('Cataracte',71,2,'\u0627\u0644\u0633\u0627\u062f'),\n          ('C\xe9phal\xe9es',72,9,'\u0635\u062f\u0627\u0639'),\n          ('Charbon gastro-intestinal',73,11,'\u0645\u0631\u0636 \u0627\u0644\u0641\u062d\u0645 \u0628\u0627\u0644\u0645\u0639\u062f\u0629 \u0648 \u0627\u0644\u0623\u0645\u0639\u0627\u0621'),\n          ('Charbon pulmonaire',74,1,'\u0645\u0631\u0636 \u0627\u